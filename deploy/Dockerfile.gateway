# Multi-stage build for the gateway.
#
# Build target is linux/amd64 by default (see Makefile); arm64 works too because every
# dependency ships an aarch64 wheel. `ffmpeg` is installed at runtime, not build time, so
# the toolchain layer stays out of the final image.

# Build metadata. The build context has no `.git` (and should not — it would be a
# 100 MB COPY and a cache-buster), so the number is passed in by `make build`, which runs
# scripts/build_info.py first. `TTSGRAB_BUILD` then overrides the baked file at runtime.
ARG VERSION=0.0.0
ARG BUILD=0
ARG VCS_REF=unknown

# ---------- stage 1: build the SPA ----------
FROM node:22.11.0-bookworm-slim AS web
WORKDIR /web

# Only package files first, so the dependency layer is cached across source edits.
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY web/ ./
# vite.config.ts writes to ../src/ttsgrab/web, i.e. /src/ttsgrab/web from /web. Copying from
# /web/dist would fail: that path has never existed.
RUN npm run build && test -f /src/ttsgrab/web/index.html

# ---------- stage 2: python wheels ----------
FROM python:3.11.10-slim-bookworm AS wheels
WORKDIR /build
RUN pip install --no-cache-dir --upgrade pip build
COPY pyproject.toml README.md pricing.yaml ./
COPY src/ ./src/
# Build a wheel so the runtime stage needs no compiler.
RUN python -m build --wheel --outdir /dist

# ---------- stage 3: runtime ----------
FROM python:3.11.10-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TTSGRAB_DATA_DIR=/data \
    TTSGRAB_HOST=0.0.0.0 \
    TTSGRAB_PORT=8000

# ffmpeg: transcoding and concatenation. curl: container healthcheck.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Non-root by default. UID/GID are build args so a NAS deployment can match its own user.
ARG UID=10001
ARG GID=10001
RUN groupadd --gid "${GID}" ttsgrab \
 && useradd --uid "${UID}" --gid "${GID}" --create-home --shell /usr/sbin/nologin ttsgrab

COPY --from=wheels /dist/*.whl /tmp/
RUN pip install --no-cache-dir /tmp/*.whl && rm -f /tmp/*.whl

ARG VERSION
ARG BUILD
ARG VCS_REF
# Overwrite whatever build_info.json came from the wheel, so the image reports its own
# build rather than the one belonging to whichever checkout produced the wheel.
RUN VERSION="${VERSION}" BUILD="${BUILD}" VCS_REF="${VCS_REF}" python - <<'EOF'
import json, os, pathlib
target = pathlib.Path("/usr/local/lib/python3.11/site-packages/ttsgrab/build_info.json")
target.write_text(json.dumps({
    "version": os.environ["VERSION"],
    "build": int(os.environ["BUILD"]),
    "commit": os.environ["VCS_REF"],
    "branch": None,
    "dirty": False,
    "built_at": None,
}, indent=2) + "\n")
print("baked build info:", target.read_text())
EOF

LABEL org.opencontainers.image.title="ttsgrab gateway" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/jmedzen/ttsgrab" \
      ttsgrab.build="${BUILD}"

# The built SPA replaces whatever the wheel shipped with.
COPY --from=web /src/ttsgrab/web/ /usr/local/lib/python3.11/site-packages/ttsgrab/web/

RUN mkdir -p /data/cache /data/reference && chown -R ttsgrab:ttsgrab /data

USER ttsgrab
WORKDIR /home/ttsgrab

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/healthz || exit 1

ENTRYPOINT ["python", "-m", "ttsgrab"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
