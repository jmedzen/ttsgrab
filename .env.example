# ttsgrab — environment template.
#
# Copy to `.env` (`make env` does it and generates an admin token), then set what you need.
# Every value is optional: the gateway boots with just Edge TTS and reports what is off.
#
# Naming rule: TTSGRAB_<SECTION>__<FIELD>, exactly as in config.example.yaml. The double
# underscore is the nesting separator, so it is not decoration — TTSGRAB_ROUTER_DEFAULT_POLICY
# is a different (unknown) variable and will be ignored.
#
# Environment variables override config.yaml.

# -- core ------------------------------------------------------------------------------
# dev | prod | test
TTSGRAB_ENV=prod
TTSGRAB_PORT=8300
# Interface to bind. 0.0.0.0 inside a container; 127.0.0.1 on a bare host behind a proxy.
TTSGRAB_HOST=0.0.0.0

# -- security --------------------------------------------------------------------------
# Required as soon as the gateway is reachable from anything but localhost.
# Generate: openssl rand -hex 24
TTSGRAB_SECURITY__ADMIN_TOKEN=

# Allow unauthenticated requests from 127.0.0.1. Handy for local dev; turn off in prod.
TTSGRAB_SECURITY__ALLOW_LOCALHOST_WITHOUT_TOKEN=true

# Allow registering workers on private LAN addresses. That is the normal case for
# self-hosted GPU boxes; set false if you genuinely have no internal workers.
TTSGRAB_SECURITY__ALLOW_PRIVATE_WORKER_URLS=true

# Restrict worker URLs to these hosts. JSON array; empty means "any host that passes the
# SSRF checks".
# TTSGRAB_SECURITY__ALLOWED_WORKER_HOSTS=["gpu-box.lan","192.168.1.50"]

# Long-lived API keys, in addition to those created through POST /v1/keys.
# JSON array. Prefer the endpoint: it hashes the key and supports revocation.
# TTSGRAB_SECURITY__API_KEYS=["ttsg_..."]

# -- free / unofficial providers -------------------------------------------------------
# Edge is the one unofficial provider enabled by default: no key, no signup, and the
# fastest way to hear something. It is not an official Microsoft API and has broken
# repeatedly; see the README's licence and stability section.
TTSGRAB_EDGE__ENABLED=true

# gTTS / translate_tts / StreamElements scrape services that offer no API, in violation of
# their terms. Off by default. Read the UI warning before enabling.
TTSGRAB_FREE_WEB__ENABLED=false

# -- Google Cloud TTS (official) -------------------------------------------------------
# Give it a service account JSON (preferred) or an API key. Never commit either.
TTSGRAB_GOOGLE_CLOUD__ENABLED=false
# In Docker, prefer a secret mount:
#   TTSGRAB_GOOGLE_CLOUD__CREDENTIALS_FILE=/run/secrets/google_credentials
TTSGRAB_GOOGLE_CLOUD__CREDENTIALS_FILE=
TTSGRAB_GOOGLE_CLOUD__API_KEY=

# Overage is billed by Google without asking. This cap refuses instead.
# Integer micro-USD: 3000000 = $3.00. 0 = no cap.
TTSGRAB_GOOGLE_CLOUD__MONTHLY_BUDGET_MICRO_USD=3000000
TTSGRAB_GOOGLE_CLOUD__RESPECT_FREE_TIER=true

# -- Google AI Studio (Gemini TTS) -----------------------------------------------------
# Keys from https://aistudio.google.com/apikey. Free and paid are separate lists because
# they behave differently: a free key gets only a few requests per DAY (Gemini TTS was cut
# to 10 RPD in November 2026), a billed key has no daily request cap. The pool spends the
# free allowance first and only then bills.
TTSGRAB_GOOGLE_AI_STUDIO__ENABLED=false
# JSON arrays: ["AIza...", "AIza..."]
# TTSGRAB_GOOGLE_AI_STUDIO__FREE_API_KEYS=["..."]
# TTSGRAB_GOOGLE_AI_STUDIO__PAID_API_KEYS=["..."]
# Requests per day allowed per free key. Google has changed this more than once.
TTSGRAB_GOOGLE_AI_STUDIO__FREE_RPD=10
# gemini-3.8-flash-tts is what this build was written against.
TTSGRAB_GOOGLE_AI_STUDIO__MODEL=gemini-3.8-flash-tts
# free_first | round_robin | least_used
TTSGRAB_GOOGLE_AI_STUDIO__STRATEGY=free_first
TTSGRAB_GOOGLE_AI_STUDIO__MONTHLY_BUDGET_MICRO_USD=1000000

# -- Azure Speech (official) -----------------------------------------------------------
# F0 gives 500k chars/month and *fails closed* (429, no charge) when exhausted, which makes
# it the safest cloud option for a personal deployment.
TTSGRAB_AZURE__ENABLED=false
TTSGRAB_AZURE__API_KEY=
TTSGRAB_AZURE__REGION=eastasia
# F0 | S0
TTSGRAB_AZURE__TIER=F0

# -- routing ---------------------------------------------------------------------------
# cheapest | fastest | best_quality | local_only | free_only
TTSGRAB_ROUTER__DEFAULT_POLICY=cheapest
TTSGRAB_ROUTER__MAX_FALLBACKS=3
TTSGRAB_ROUTER__CIRCUIT_BREAKER_THRESHOLD=3
TTSGRAB_ROUTER__CIRCUIT_BREAKER_COOLDOWN_S=60

# -- cache -----------------------------------------------------------------------------
TTSGRAB_CACHE__MAX_BYTES=2147483648
TTSGRAB_CACHE__TTL_SECONDS=2592000

# -- long-form -------------------------------------------------------------------------
TTSGRAB_LONGFORM__CHUNK_THRESHOLD=1200
TTSGRAB_LONGFORM__MAX_CONCURRENCY=4

# -- workers ---------------------------------------------------------------------------
TTSGRAB_WORKERS__HEALTH_INTERVAL_S=20
TTSGRAB_WORKERS__UNHEALTHY_THRESHOLD=3

# -- MCP -------------------------------------------------------------------------------
TTSGRAB_MCP__ENABLED=true
TTSGRAB_MCP__PATH=/mcp

# -- database --------------------------------------------------------------------------
# Default is SQLite under the data volume. For Postgres, install the extra and switch.
#   pip install "ttsgrab[postgres]"
# A plain postgresql:// URL is rewritten to postgresql+asyncpg:// automatically.
# TTSGRAB_DATABASE_URL=postgresql+asyncpg://ttsgrab:secret@db:5432/ttsgrab

# -- logging ---------------------------------------------------------------------------
TTSGRAB_LOG_LEVEL=INFO
# json suits production; console is friendlier in a terminal.
TTSGRAB_LOG_FORMAT=json

# -- tls profile (`docker compose --profile tls up`) ------------------------------------
# Only read by the bundled Caddy service. Leave TTSGRAB_DOMAIN=localhost for a local
# self-signed certificate; set a real hostname that resolves here for Let's Encrypt.
TTSGRAB_DOMAIN=localhost
# Let's Encrypt expiry notices go here. Optional, but you will regret leaving it blank.
ACME_EMAIL=

# -- pricing ---------------------------------------------------------------------------
# Directory holding pricing.yaml. If unset, the gateway looks next to the config file, then
# the working directory, then upward from the package. Point it at a mounted volume to edit
# prices without rebuilding the image.
# TTSGRAB_CONFIG_DIR=/config
