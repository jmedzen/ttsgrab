# ttsgrab — environment template.
#
# Copy to `.env` (`make env` does it and generates a token), then fill in what you need.
# Every value is optional: the gateway boots with just Edge TTS and tells you what is off.

# -- core ------------------------------------------------------------------------------
TTSGRAB_ENV=production
TTSGRAB_PORT=8000
# Bind address for the published port. Keep 127.0.0.1 and put a reverse proxy in front
# for anything internet-facing.
TTSGRAB_BIND=127.0.0.1

# -- security --------------------------------------------------------------------------
# Required as soon as the gateway is reachable from anything but localhost.
# Generate: openssl rand -hex 24
TTSGRAB_ADMIN_TOKEN=

# Allow unauthenticated requests from 127.0.0.1. Handy for local dev; turn off in prod.
TTSGRAB_ALLOW_LOCALHOST=true

# -- free / unofficial providers -------------------------------------------------------
# Edge is the one unofficial provider enabled by default: it needs no key, and it is the
# fastest way to hear something. It is not an official Microsoft API and can break; see
# README's "Licence and stability" section.
TTSGRAB_EDGE_ENABLED=true

# gTTS / translate_tts / StreamElements are OFF by default. Turning them on means scraping
# a service that does not offer an API. Read the warning in the UI first.
TTSGRAB_FREE_WEB__ENABLED=false

# -- Google Cloud TTS ------------------------------------------------------------------
# Either an API key OR a service-account JSON file. Never commit either.
TTSGRAB_GOOGLE_ENABLED=false
GOOGLE_API_KEY=
GOOGLE_CREDENTIALS_FILE=./secrets/google-credentials.json

# -- Gemini TTS (separate API, key pool) -----------------------------------------------
# Comma-separated. Free keys and paid keys can be mixed; the pool rotates and cools down
# a key that returns 401/403/429 instead of failing the whole request.
TTSGRAB_GEMINI_ENABLED=false
GEMINI_API_KEYS=
# gemini-3.8-flash-tts is the model this build was written against. Override if your
# account exposes a different TTS model id.
TTSGRAB_GEMINI_MODEL=gemini-3.8-flash-tts
TTSGRAB_GEMINI_KEY_STRATEGY=round_robin

# -- Azure Speech ----------------------------------------------------------------------
# F0 gives 500k chars/month free and *fails closed* (429, no charge) when exhausted, which
# makes it the safest cloud option for a personal deployment.
TTSGRAB_AZURE_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
TTSGRAB_AZURE_TIER=F0

# -- money -----------------------------------------------------------------------------
# Hard monthly ceiling in USD, across all paid providers. 0 = no limit.
# When the cap is hit, requests are refused with HTTP 402 budget_exceeded. The gateway does
# NOT silently downgrade to a free provider — that was a deliberate choice.
TTSGRAB_MONTHLY_BUDGET_USD=5

# Per-provider character caps, if you want them tighter than the dollar cap.
# TTSGRAB_BUDGETS__GOOGLE_CLOUD_CHARS=2000000

# -- cache -----------------------------------------------------------------------------
TTSGRAB_CACHE_MAX_BYTES=2147483648
TTSGRAB_CACHE_TTL_SECONDS=2592000

# -- routing ---------------------------------------------------------------------------
TTSGRAB_ROUTER__DEFAULT_POLICY=cheapest
TTSGRAB_ROUTER__ALLOW_FALLBACK=true

# -- workers ---------------------------------------------------------------------------
# Allow registering workers on private LAN addresses. Set false if you only ever use
# public endpoints and want to be sure nothing can probe your internal network.
TTSGRAB_SECURITY__ALLOW_PRIVATE_WORKER_URLS=true
TTSGRAB_SECURITY__ALLOWED_WORKER_HOSTS=

# -- database --------------------------------------------------------------------------
# Default is SQLite under the data volume. For Postgres, install the extra and switch:
#   pip install "ttsgrab[postgres]"
# TTSGRAB_DATABASE_URL=postgresql+asyncpg://ttsgrab:secret@db:5432/ttsgrab

# -- logging ---------------------------------------------------------------------------
TTSGRAB_LOG_LEVEL=INFO
TTSGRAB_LOG_FORMAT=json

# -- tls profile (`docker compose --profile tls up`) ------------------------------------
# Only used by the bundled Caddy service. Leave TTSGRAB_DOMAIN=localhost to get a local
# self-signed certificate; set a real hostname that points at this box to get Let's Encrypt.
TTSGRAB_DOMAIN=localhost
# Let's Encrypt expiry notices go here. Optional, but you will regret leaving it blank.
ACME_EMAIL=

# -- pricing ---------------------------------------------------------------------------
# Directory holding pricing.yaml. If unset, the gateway looks in the config file's
# directory, the working directory, then the packaged copy. Point it at a mounted volume
# if you want to edit prices without rebuilding the image.
# TTSGRAB_CONFIG_DIR=/config
